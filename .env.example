# KIW1 Configuration
# Copy this file to .env and set your values

# Google Gemini API Key (Required for AI Studio free tier or Vertex AI)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Google Cloud Project ID (Required for Firestore, Pub/Sub, Cloud Run)
GOOGLE_CLOUD_PROJECT=kiw1-agent

# Cloud Region
GOOGLE_CLOUD_REGION=us-central1

# Default user ID for single-user personal harness
KIW1_UID=demo-user

# Effort control: quick | standard | thorough
# quick = 0 thinking budget (fastest)
# standard = 2048 thinking budget
# thorough = 8192 thinking budget (deep reasoning)
KIW1_DEFAULT_EFFORT=standard

# Vault Egress Mode: sealed | answers-only | excerpt
# sealed = vault plugin disabled
# answers-only = locally generated answers cross boundary, no raw text
# excerpt = explicitly approved snippets only
KIW1_VAULT_MODE=answers-only

# Local Vault Directory Path (Used by local Vault Node)
KIW1_LOCAL_VAULT_PATH=./seed/synthetic_vault

# Overnight Research Auto Schedule (cron format or 'off' / 'manual')
KIW1_RESEARCH_SCHEDULE=0 3 * * *

# Port for local server / Cloud Run container
PORT=8080
